# Server only; never put a key in a VITE_ variable.
WALK_FREE_OPENAI_API_KEY=
WALK_FREE_OPENAI_MODEL=gpt-4.1-mini
# Native builds only: HTTPS origin of your deployed Vercel backend.
VITE_API_BASE_URL=

# Optional alternate provider; must be reachable from your server's network.
WALK_FREE_OVERPASS_URL=https://overpass-api.de/api/interpreter

# Managed email/password authentication; the URL contains no password or API key.
WALK_FREE_AUTH_URL=
# Exact public origin, e.g. https://walk-free.vercel.app (no trailing slash).
WALK_FREE_APP_URL=
# Hosted AI stays disabled until durable shared usage limits are implemented.
