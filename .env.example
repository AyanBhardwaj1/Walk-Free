# Server only; never put a key in a VITE_ variable.
WALK_FREE_OPENAI_API_KEY=
# Optional: any OpenAI-compatible provider and model. For Meta's Muse Spark,
# put a Meta Model API key in WALK_FREE_AI_API_KEY, set the base URL to
# https://api.meta.ai/v1 and leave the model empty (defaults to muse-spark-1.3).
WALK_FREE_AI_BASE_URL=https://api.openai.com/v1
# WALK_FREE_AI_MODEL=gpt-5-mini
# Hosted AI requires a Postgres URL for shared usage limits (e.g. your Neon
# project's connection string). Local development falls back to memory.
WALK_FREE_DATABASE_URL=
# Assistant model calls per user per day, and for the whole site per month.
WALK_FREE_AI_DAILY_LIMIT=80
WALK_FREE_AI_MONTHLY_LIMIT=4000
# Native builds only: HTTPS origin of your deployed Vercel backend.
VITE_API_BASE_URL=

# Optional preferred Overpass instance; public mirrors are tried after it.
WALK_FREE_OVERPASS_URL=

# Managed email/password authentication; the URL contains no password or API key.
WALK_FREE_AUTH_URL=
# Exact public origin, e.g. https://walk-free.vercel.app (no trailing slash).
WALK_FREE_APP_URL=
