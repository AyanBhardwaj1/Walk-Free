# Server only; never put a key in a VITE_ variable.
WALK_FREE_OPENAI_API_KEY=
WALK_FREE_OPENAI_MODEL=gpt-4.1-mini
# Native builds only: HTTPS origin of your deployed Vercel backend.
VITE_API_BASE_URL=

# Optional alternate provider; enable its hostname in environment network settings.
WALK_FREE_OVERPASS_URL=https://overpass-api.de/api/interpreter
